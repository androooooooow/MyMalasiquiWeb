PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MOBILE_URL=

# DATABASE_URL is optional. The app and npm database scripts automatically
# construct it from the existing DB_* variables when it is omitted.
DATABASE_URL=postgresql://postgres:password@localhost:5432/malasiqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=malasiqui
DB_USER=postgres
DB_PASSWORD=password

JWT_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Gmail SMTP is required to deliver 6-digit verification codes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
# Use a 16-character Google App Password, not the normal Gmail password.
SMTP_PASS=your-google-app-password
EMAIL_FROM="RESCUE APP <your-gmail-address@gmail.com>"
