PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MOBILE_URL=

# DATABASE_URL is optional. The app and npm database scripts automatically
# construct it from the existing DB_* variables when it is omitted.
DATABASE_URL=postgresql://postgres:password@localhost:5432/malasiqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=malasiqui
DB_USER=postgres
DB_PASSWORD=password

JWT_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# SMTP is required to deliver verification emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Malasiqui Rescue <no-reply@example.com>"
