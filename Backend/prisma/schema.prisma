generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  address                String
  phoneNum               String    @map("phone_num")
  email                  String    @unique
  role                   String
  responderUnit          ResponderUnit? @map("responder_unit")
  password               String
  emailVerifiedAt        DateTime? @map("email_verified_at")
  emailVerificationToken String?   @unique @map("email_verification_token")
  verificationExpiresAt  DateTime? @map("verification_expires_at")
  googleSub              String?   @unique @map("google_sub")
  authProvider           String    @default("local") @map("auth_provider")
  blockedAt              DateTime? @map("blocked_at")
  blockReason            String?   @map("block_reason")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")
  emergencyRequests      EmergencyRequest[] @relation("CitizenEmergencyRequests")
  assignedEmergencyRequests EmergencyRequest[] @relation("ResponderEmergencyRequests")
  chatConversations      ChatConversation[] @relation("CitizenChatConversations")
  chatMessages           ChatMessage[] @relation("SentChatMessages")
  adminActions           AdminAuditLog[] @relation("AdminAuditActor")
  receivedAdminActions   AdminAuditLog[] @relation("AdminAuditTarget")

  @@map("users")
  @@index([role, responderUnit])
}

enum ResponderUnit {
  HEALTH_AMBULANCE
  PNP_POLICE
  BFP_FIRE
  MDRRMO
}

enum EmergencyService {
  AMBULANCE
  FIRE
  POLICE
  SEARCH_RESCUE
  DISASTER
  OTHER
}

enum EmergencyStatus {
  PENDING
  ACCEPTED
  EN_ROUTE
  RESOLVED
  CANCELLED
}

model EmergencyRequest {
  id                  String           @id @default(cuid())
  citizenId           Int              @map("citizen_id")
  assignedResponderId Int?             @map("assigned_responder_id")
  activeCitizenId     Int?             @unique @map("active_citizen_id")
  service             EmergencyService
  status              EmergencyStatus  @default(PENDING)
  description         String
  peopleAffected      String           @map("people_affected")
  landmark            String?
  callbackPhone       String?          @map("callback_phone")
  latitude            Float
  longitude           Float
  accuracyMeters      Int              @map("accuracy_meters")
  responderLatitude   Float?           @map("responder_latitude")
  responderLongitude  Float?           @map("responder_longitude")
  responderAccuracyMeters Int?         @map("responder_accuracy_meters")
  responderLocationUpdatedAt DateTime? @map("responder_location_updated_at")
  acceptedAt          DateTime?        @map("accepted_at")
  resolvedAt          DateTime?        @map("resolved_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at")

  citizen             User             @relation("CitizenEmergencyRequests", fields: [citizenId], references: [id], onDelete: Restrict)
  assignedResponder   User?            @relation("ResponderEmergencyRequests", fields: [assignedResponderId], references: [id], onDelete: SetNull)

  @@index([citizenId, createdAt])
  @@index([assignedResponderId, status])
  @@index([status, createdAt])
  @@map("emergency_requests")
}

model ChatConversation {
  id            String        @id @default(cuid())
  citizenId     Int           @map("citizen_id")
  responderUnit ResponderUnit @map("responder_unit")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  citizen       User          @relation("CitizenChatConversations", fields: [citizenId], references: [id], onDelete: Restrict)
  messages      ChatMessage[]

  @@unique([citizenId, responderUnit])
  @@index([responderUnit, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  senderId       Int              @map("sender_id")
  body           String
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt, id])
  @@map("chat_messages")
}

enum AdminAuditAction {
  USER_BLOCKED
  USER_UNBLOCKED
}

model AdminAuditLog {
  id           String           @id @default(cuid())
  actorId      Int              @map("actor_id")
  targetUserId Int              @map("target_user_id")
  action       AdminAuditAction
  reason       String?
  createdAt    DateTime         @default(now()) @map("created_at")

  actor        User             @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser   User             @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_audit_logs")
}
